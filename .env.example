# Qyne — Local Development Environment Variables
# Copy to .env and fill in external API keys.
# Database and Redis passwords match docker-compose.yml defaults.

# === PostgreSQL (local Docker) ===
DATABASE_URL=postgresql://qyne:qyne_dev@localhost:5432/qyne
AGNO_DB_URL=postgresql://agno:agno_dev@localhost:5433/agno
PREFECT_DB_URL=postgresql://prefect:prefect_dev@localhost:5434/prefect

# === Redis (local Docker) ===
REDIS_URL=redis://:qyne_dev@localhost:6379/0

# === Auth (get from https://dashboard.clerk.com) ===
CLERK_SECRET_KEY=

# === AI / LLM ===
OPENAI_API_KEY=
GROQ_API_KEY=

# === External Services ===
FAL_KEY=
RESEND_API_KEY=

# === Cloudflare R2 (get from Cloudflare dashboard) ===
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=qyne-images
R2_ENDPOINT=

# === App URLs (local dev defaults) ===
NUXT_PUBLIC_API_URL=http://localhost:3000
PORT=3000
