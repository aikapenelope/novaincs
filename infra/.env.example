# Nova — Environment Variables
# Copy this file to .env and fill in all values.
#
# Generate passwords with: openssl rand -base64 32

# === PostgreSQL ===

# pg-nova: Superuser (for migrations only — NOT used by the app at runtime)
PG_NOVA_PASSWORD=

# pg-nova: Application role (qyne_app) — used by nova-api, RLS enforced
PG_NOVA_APP_PASSWORD=

# pg-nova: Read-only user for nova-agents (create manually after first boot)
PG_NOVA_RO_PASSWORD=

# pg-agno: Agent database (memories, sessions, traces)
PG_AGNO_PASSWORD=

# pg-prefect: Workflow database (flow runs, schedules)
PG_PREFECT_PASSWORD=

# === Redis ===

REDIS_PASSWORD=

# === Auth ===

# Clerk (https://dashboard.clerk.com)
CLERK_SECRET_KEY=

# === AI / LLM ===

# OpenAI — GPT-5 Mini for agents (https://platform.openai.com)
OPENAI_API_KEY=

# Groq — Whisper for voice, fast LLM (https://console.groq.com)
GROQ_API_KEY=

# === External Services ===

# Photoroom — Image enhancement API (https://www.photoroom.com/api)
PHOTOROOM_API_KEY=

# Resend — Transactional email (https://resend.com)
RESEND_API_KEY=
